# Copie este arquivo para .env.local e preencha com os seus valores.
# O .env.local nunca vai para o git (esta no .gitignore).

# Supabase (Project Settings > API Keys)
# A chave "publishable" pode aparecer no navegador: quem protege os dados e o RLS.
# NUNCA coloque aqui a chave "secret" / "service_role".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# E-mails de boas-vindas (resend.com) - usada so no servidor
# Para testar sem dominio: "Todos os Jeitos <onboarding@resend.dev>" (so envia para o seu proprio e-mail)
# Com o dominio configurado: "Todos os Jeitos <contato@todososjeitos.com>"
RESEND_API_KEY=
EMAIL_REMETENTE=Todos os Jeitos <onboarding@resend.dev>

# Anthropic (console.anthropic.com) - usada so no servidor
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
