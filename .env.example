# Copie este arquivo para .env.local e preencha com os seus valores.
# O .env.local nunca vai para o git (esta no .gitignore).

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic (console.anthropic.com) - usada so no servidor
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
